# Vzor proměnných prostředí (skutečné hodnoty NIKDY do repozitáře — patří do
# Vercel → Settings → Environment Variables). Zkopírujte klíče z jednotlivých
# služeb podle docs/nastaveni-uctu.md.

# --- Stripe (platby) ---
# Test: sk_test_… / Ostře: sk_live_…  (z Developers → API keys)
STRIPE_SECRET_KEY=sk_test_xxx
# Tajný podpis webhooku (z Developers → Webhooks → váš endpoint → Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Adresa webu, kam Stripe vrátí zákazníka po platbě
SITE_URL=https://pozemkomat.vercel.app

# --- Supabase (databáze) — Fáze 1 ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (e-maily) — Fáze 4 ---
RESEND_API_KEY=
